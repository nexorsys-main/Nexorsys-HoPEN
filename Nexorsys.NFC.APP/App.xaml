<Application x:Class="Pinede.NFC.APP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pinede.NFC.APP"
             xmlns:vues="clr-namespace:Pinede.NFC.APP.Vues"
             xmlns:vuemodeles="clr-namespace:Pinede.NFC.APP.VueModeles"
             xmlns:converters="clr-namespace:Pinede.NFC.APP.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            
            <DataTemplate DataType="{x:Type vuemodeles:EcranAttenteVueModele}">
                <vues:EcranAttente />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vuemodeles:EcranAuthentificationVueModele}">
                <vues:EcranAuthentification />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vuemodeles:EcranChangementPinVueModele}">
                <vues:EcranChangementPin />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vuemodeles:EcranAccueilVueModele}">
                <vues:EcranAccueil />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vuemodeles:EcranErreurVueModele}">
                <vues:EcranErreur />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vuemodeles:EcranParametresVueModele}">
                <vues:EcranParametres />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vuemodeles:EcranAdminAuthVueModele}">
                <vues:EcranAdminAuth />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
