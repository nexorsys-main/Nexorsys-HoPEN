<UserControl x:Class="Pinede.NFC.APP.Vues.EcranAttente"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F9">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <Style TargetType="Border" x:Key="AuthCardStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#A0AEC0" Opacity="0.1" BlurRadius="15" ShadowDepth="4" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="AuthTitleStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="AuthSubtitleStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Grid Grid.Row="0" Margin="30,30,30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/Assets/logo.png" MaxHeight="60" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Button Grid.Column="1" Content="⚙ Administration" Command="{Binding OuvrirParametresCommand}" 
                    Padding="15,8" Background="Transparent" BorderThickness="1" BorderBrush="#CBD5E0" Foreground="#4A5568" Cursor="Hand" FontWeight="SemiBold"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Terminal d'Authentification Clinique" FontSize="32" FontWeight="ExtraBold" Foreground="#1A202C" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Veuillez sélectionner votre méthode de connexion sécurisée" FontSize="16" Foreground="#4A5568" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- AUTHENTICATION OPTIONS GRID -->
                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,10">
                    
                    <!-- LIGNE 1 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- NFC BADGE -->
                        <Border Style="{StaticResource AuthCardStyle}" Visibility="{Binding TerminalConfig.MieNfcEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="📡" FontSize="40" HorizontalAlignment="Center" Foreground="#2C7A7B"/>
                                <TextBlock Text="Badge NFC" Style="{StaticResource AuthTitleStyle}"/>
                                <TextBlock Text="Présentez votre badge sur le lecteur sans contact" Style="{StaticResource AuthSubtitleStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- CARTE CPS / CPE -->
                        <Border Style="{StaticResource AuthCardStyle}" Visibility="{Binding TerminalConfig.MieCpsEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="💳" FontSize="40" HorizontalAlignment="Center" Foreground="#2C7A7B"/>
                                <TextBlock Text="Carte CPS / CPE" Style="{StaticResource AuthTitleStyle}"/>
                                <TextBlock Text="Insérez votre carte de professionnel de santé" Style="{StaticResource AuthSubtitleStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- CLÉ FIDO2 -->
                        <Border Style="{StaticResource AuthCardStyle}" Visibility="{Binding TerminalConfig.MieFidoEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🔑" FontSize="40" HorizontalAlignment="Center" Foreground="#2C7A7B"/>
                                <TextBlock Text="Clé FIDO2" Style="{StaticResource AuthTitleStyle}"/>
                                <TextBlock Text="Insérez et touchez votre clé de sécurité USB" Style="{StaticResource AuthSubtitleStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- LIGNE 2 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- CARTE PSÉ -->
                        <Border Style="{StaticResource AuthCardStyle}" Visibility="{Binding TerminalConfig.MieCartePsEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🏥" FontSize="40" HorizontalAlignment="Center" Foreground="#2C7A7B"/>
                                <TextBlock Text="Carte PSÉ" Style="{StaticResource AuthTitleStyle}"/>
                                <TextBlock Text="Carte Professionnel de Santé d'Établissement" Style="{StaticResource AuthSubtitleStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- PSI TOKEN -->
                        <Border Style="{StaticResource AuthCardStyle}" Visibility="{Binding TerminalConfig.MiePsiEnabled, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="40" HorizontalAlignment="Center" Foreground="#2C7A7B"/>
                                <TextBlock Text="Token PSI" Style="{StaticResource AuthTitleStyle}"/>
                                <TextBlock Text="Jeton d'authentification forte logiciel" Style="{StaticResource AuthSubtitleStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

            <!-- Loading indicator for physical readers -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                <ProgressBar IsIndeterminate="True" Width="100" Height="4" Foreground="#3182CE" Background="#E2E8F0" BorderThickness="0" Margin="0,0,15,0"/>
                <TextBlock Text="Lecture matérielle active en arrière-plan..." FontSize="13" Foreground="#718096" FontStyle="Italic" VerticalAlignment="Center"/>
            </StackPanel>
            
            <PasswordBox IsEnabled="False" Width="0" Height="0" Opacity="0"/> <!-- Keeps focus logic happy if needed -->
            </StackPanel>
        </Viewbox>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Moyens d'Identification Électronique (MIE) gérés par Pinède Identity" VerticalAlignment="Center" Foreground="#A0AEC0" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Développé par Ali HAMIDY" VerticalAlignment="Center" Foreground="#CBD5E0" FontSize="12"/>
            </Grid>
        </Border>

        <!-- ENCODING MODE OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#E6F4F7F9" Visibility="{Binding IsModeEncodage, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="15" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    BorderBrush="#3182CE" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="#A0AEC0" Opacity="0.3" BlurRadius="20" ShadowDepth="5" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🔄" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="MODE ENCODAGE ACTIF" FontSize="24" FontWeight="Bold" Foreground="#2B6CB0" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Veuillez présenter un badge vierge sur le lecteur NFC" FontSize="16" Foreground="#4A5568" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ne retirez pas le badge avant la confirmation..." FontSize="14" Foreground="#E53E3E" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
