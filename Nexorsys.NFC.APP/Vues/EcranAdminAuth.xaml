<UserControl x:Class="Pinede.NFC.APP.Vues.EcranAdminAuth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F4F8">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🔒 Accès Restreint" FontSize="32" FontWeight="Bold" Foreground="#102A43" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Veuillez saisir votre identifiant et mot de passe administrateur Nexorsys pour accéder aux réglages. (Ou laissez l'identifiant vide pour utiliser le mot de passe local) :" FontSize="16" Foreground="#486581" HorizontalAlignment="Center" Margin="0,0,0,15" MaxWidth="500" TextWrapping="Wrap" TextAlignment="Center"/>
            
            <TextBox Name="AdminIdentifiantBox" Width="300" Height="40" Margin="0,0,0,10" Padding="10" 
                     Background="White" BorderBrush="#003E6B" BorderThickness="2" 
                     HorizontalContentAlignment="Center" FontSize="16"
                     Tag="Identifiant (optionnel pour local)"/>

            <PasswordBox Name="AdminMdpBox" Width="300" Height="40" Margin="0,0,0,10" Padding="10" 
                         Background="White" BorderBrush="#003E6B" BorderThickness="2" 
                         HorizontalContentAlignment="Center" FontSize="16"/>
            
            <TextBlock Text="{Binding MessageErreur}" Foreground="#D64545" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Annuler" Command="{Binding AnnulerCommand}" 
                        Padding="20,10" Background="White" Foreground="#486581" BorderBrush="#BCCCDC" BorderThickness="1"
                        Margin="0,0,10,0" Cursor="Hand" FontSize="16"/>
                <Button Content="Accéder" Click="Accees_Click" IsDefault="True"
                        Padding="20,10" Background="#003E6B" Foreground="White" BorderThickness="0"
                        Cursor="Hand" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
