<Window x:Class="Pinede.NFC.APP.Vues.EcranDiagnostic"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostic Clinique La Pinède" 
        Height="350" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Border Background="{StaticResource BrushPrimarySage}" 
            CornerRadius="20" 
            BorderBrush="{StaticResource BrushDeepForest}" 
            BorderThickness="2"
            Padding="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.3" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
                <Image Source="/Assets/logo.png" Height="30" Margin="0,0,15,0"/>
                <TextBlock Text="Synchronisation Réussie !" 
                           FontSize="22" 
                           FontWeight="Black" 
                           Foreground="{StaticResource BrushDeepForest}"/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TxtUtilisateur" 
                               Text="Utilisateur : " 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushTextDark}" 
                               Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Logiciels reçus du serveur :" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushClinicalGreen}" 
                               Margin="0,0,0,5"/>
                    
                    <TextBlock x:Name="TxtLogiciels" 
                               Text="" 
                               FontSize="14" 
                               LineHeight="20"
                               Foreground="{StaticResource BrushTextDark}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer / Timer info -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Button Content="OK" 
                        Click="Ok_Click" 
                        Width="120" 
                        Style="{StaticResource PrimaryButton}" 
                        HorizontalAlignment="Right"/>
                <ProgressBar x:Name="ProgressTimer" 
                             Height="4" 
                             Margin="0,15,0,0" 
                             Background="Transparent" 
                             BorderThickness="0"
                             Foreground="{StaticResource BrushClinicalGreen}"
                             Minimum="0" Maximum="6000"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
