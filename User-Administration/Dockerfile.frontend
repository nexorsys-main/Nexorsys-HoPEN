# Frontend Dockerfile
FROM node:20-alpine AS builder
WORKDIR /app
COPY frontend/nexorsys-identity-ui/package*.json ./
RUN npm install
COPY frontend/nexorsys-identity-ui/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]