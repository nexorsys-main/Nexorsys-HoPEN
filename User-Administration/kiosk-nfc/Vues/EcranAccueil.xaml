<UserControl x:Class="Nexorsys.NFC.APP.Vues.EcranAccueil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000" 
             Background="{StaticResource BrushPrimarySage}">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="NexorSys" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushDeepForest}" Margin="0,0,24,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="NexorSys Kiosk" FontSize="24" FontWeight="Black" Foreground="{StaticResource BrushDeepForest}"/>
                    <TextBlock Text="Kiosque d'Accès Sécurisé" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushClinicalGreen}" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
            
            <Button Content="Déconnexion" Command="{Binding DeconnexionCommand}" 
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="20,10"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
            <TextBlock Text="Bonjour," FontSize="18" Foreground="{StaticResource BrushTextDark}" Opacity="0.7" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding NomUtilisateur}" FontSize="40" FontWeight="Black" Foreground="{StaticResource BrushDeepForest}" HorizontalAlignment="Center" Margin="0,4,0,32"/>
            
            <TextBlock Text="VOS APPLICATIONS MÉTIER" FontSize="12" FontWeight="Black" Foreground="{StaticResource BrushClinicalGreen}" HorizontalAlignment="Center" Margin="0,0,0,24" Opacity="0.6"/>
            
            <ItemsControl ItemsSource="{Binding ApplicationsAutorisees}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="240" Height="140" Margin="12" Cursor="Hand"
                                Command="{Binding DataContext.LancerApplicationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder" Style="{StaticResource GlassCard}" Padding="0">
                                        <Grid>
                                            <Border x:Name="Accent" Background="{StaticResource BrushDeepForest}" Width="6" HorizontalAlignment="Left" CornerRadius="12,0,0,12" Opacity="0"/>
                                            <StackPanel VerticalAlignment="Center" Margin="24">
                                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Black" Foreground="{StaticResource BrushDeepForest}" TextWrapping="Wrap" TextAlignment="Center"/>
                                                <TextBlock Text="Accès Instantané" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushClinicalGreen}" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushClinicalGreen}"/>
                                            <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource MediumShadow}"/>
                                            <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- FOOTER -->
        <TextBlock Grid.Row="2" Text="NEXORSYS KIOSK — Secure Workstation Authentication"
                   HorizontalAlignment="Center" Foreground="{StaticResource BrushClinicalGreen}" Opacity="0.4" 
                   FontSize="11" FontWeight="Black"/>
    </Grid>
</UserControl>
