<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.5.3.0</Version>
    <Authors>Ali HAMIDY</Authors>
    <Company>NexorSys</Company>
    <Product>NexorSys Kiosk</Product>
    <AssemblyName>NexorSysKiosk</AssemblyName>
    <Description>NexorSys Kiosk workstation authentication client</Description>
    <Copyright>Copyright © NexorSys</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.MessageBox" Alias="MessageBox" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\nexorsys-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\backend\src\Nexorsys.Agent.Core\Nexorsys.Agent.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="PCSC" Version="7.0.1" />
    <PackageReference Include="PCSC.Iso7816" Version="7.0.1" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
  </ItemGroup>


  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
