# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=NexorSys_Dev;Username=nexorsys_dev;Password=<from-secret-provider>

# JWT Authentication
Jwt__Key=your-super-secret-jwt-key-change-in-production
Jwt__Issuer=NexorSys.Identity
Jwt__Audience=NexorSys.Identity.Clients

# LDAP/AD Configuration (for production)
# Ldap__Url=ldaps://your-ad-server:636
# Ldap__Username=CN=ServiceAccount,OU=ServiceAccounts,DC=domain,DC=com
# Ldap__Password=your-service-account-password

# CORS
CORS__AllowedOrigins=https://identity.example.invalid,https://kiosk.example.invalid
