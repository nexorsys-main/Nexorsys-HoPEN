<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.5.3</Version>
    <Authors>NexorSys</Authors>
    <Company>NexorSys</Company>
    <Product>NexorSys Identity API</Product>
    <Description>Commercial identity, authentication, authorization, and kiosk API</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.31" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexorsys.Identity.Core\Nexorsys.Identity.Core.csproj" />
    <ProjectReference Include="..\Nexorsys.Agent.Core\Nexorsys.Agent.Core.csproj" />
    <ProjectReference Include="..\Nexorsys.Identity.Infrastructure\Nexorsys.Identity.Infrastructure.csproj" />
  </ItemGroup>

</Project>
